{:paths ["src" "target/classes"]
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}
        com.github.seancorfield/honeysql {:mvn/version "2.7.1392"}
        org.duckdb/duckdb_jdbc {:mvn/version "1.5.5.1"}
        ai.djl/api {:mvn/version "0.36.0"}
        ai.djl.pytorch/pytorch-engine {:mvn/version "0.36.0"}
        ai.djl.pytorch/pytorch-jni {:mvn/version "2.7.1-0.36.0"}
        ai.djl.pytorch/pytorch-native-cpu$linux-x86_64 {:mvn/version "2.7.1"}}
 :aliases
 {:test {:extra-paths ["test" "examples"]
         :main-opts ["-m" "garun.test-runner"]}
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.7"}}
          :ns-default build}
  ;; Exclude the bundled CPU native jar; DJL downloads/caches the CUDA runtime.
  :cuda {:classpath-overrides {ai.djl.pytorch/pytorch-native-cpu$linux-x86_64 ""}
         :jvm-opts ["-DPYTORCH_VERSION=2.7.1" "-DPYTORCH_FLAVOR=cu128"]}
  :zoo {:extra-deps {ai.djl/model-zoo {:mvn/version "0.36.0"}
                     ai.djl.pytorch/pytorch-model-zoo {:mvn/version "0.36.0"}}}}}
